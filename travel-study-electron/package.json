{
  "name": "travel-study-electron",
  "version": "0.1.0",
  "private": true,
  "description": "游学纪：面向中小学研学内容生产的 Electron 桌面应用 MVP。",
  "main": "electron/main.cjs",
  "license": "MIT",
  "type": "commonjs",
  "packageManager": "pnpm@10.4.1",
  "scripts": {
    "dev": "concurrently -k \"npm run dev:renderer\" \"npm run dev:electron\"",
    "dev:renderer": "npm --prefix renderer run dev -- --port 5173",
    "dev:electron": "wait-on http://127.0.0.1:5173 && cross-env ELECTRON_RENDERER_URL=http://127.0.0.1:5173 electron .",
    "build:renderer": "npm --prefix renderer run build",
    "start": "npm run build:renderer && electron .",
    "lint": "npm --prefix renderer exec vite -- --version"
  },
  "dependencies": {
    "@ffmpeg-installer/ffmpeg": "^1.1.0",
    "@pdf-lib/fontkit": "^1.1.1",
    "ffmpeg-static": "^5.2.0",
    "ffprobe-static": "^3.1.0",
    "pdf-lib": "^1.17.1",
    "sql.js": "^1.13.0"
  },
  "devDependencies": {
    "concurrently": "^9.1.2",
    "cross-env": "^7.0.3",
    "electron": "^36.4.0",
    "wait-on": "^8.0.3"
  }
}
